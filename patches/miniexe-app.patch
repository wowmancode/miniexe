+    }
+
+    public void launchProgram(int containerId, String path, boolean shortcut) {
+        if (!new java.io.File(path).isFile()) return;
+        recordRecent(this, containerId, path, shortcut);
+        if (XServerDisplayActivity.tryLaunchInSession(this, containerId, path, shortcut)) return;
+        Intent intent = new Intent(this, XServerDisplayActivity.class);
+        intent.putExtra("container_id", containerId);
+        intent.putExtra(shortcut ? "shortcut_path" : "exec_path", path);
+        startActivity(intent);
+    }
+
+    public static void recordRecent(Context context, int containerId, String path, boolean shortcut) {
+        SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
+        JSONArray old;
+        try { old = new JSONArray(prefs.getString("miniexe_recent", "[]")); }
+        catch (Exception e) { old = new JSONArray(); }
+        JSONArray recent = new JSONArray();
+        try {
+            JSONObject item = new JSONObject();
+            item.put("container_id", containerId);
+            item.put("path", path);
+            item.put("shortcut", shortcut);
+            recent.put(item);
+            for (int i = 0; i < old.length() && recent.length() < 10; i++) {
+                JSONObject other = old.optJSONObject(i);
+                if (other != null && !path.equals(other.optString("path"))) recent.put(other);
+            }
+            prefs.edit().putString("miniexe_recent", recent.toString()).apply();
+        }
+        catch (Exception ignored) {}
     }
 
