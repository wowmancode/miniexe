+package com.winlator;
+
+import android.os.Bundle;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.CheckBox;
+import android.widget.LinearLayout;
+import android.widget.RadioButton;
+import android.widget.RadioGroup;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.fragment.app.Fragment;
+import androidx.preference.PreferenceManager;
+
+import com.winlator.core.AppUtils;
+
+public class MiniSettingsFragment extends Fragment {
+    @Nullable
+    @Override
+    public View onCreateView(@NonNull android.view.LayoutInflater inflater, @Nullable ViewGroup parent, @Nullable Bundle state) {
+        ScrollView scroll = new ScrollView(requireContext());
+        LinearLayout content = new LinearLayout(requireContext());
+        content.setOrientation(LinearLayout.VERTICAL);
+        int padding = (int)(16 * getResources().getDisplayMetrics().density);
+        content.setPadding(padding, padding, padding, padding);
+        scroll.addView(content);
+
+        TextView title = new TextView(requireContext());
+        title.setText(R.string.settings);
+        title.setTextSize(22);
+        content.addView(title);
+
+        RadioGroup themes = new RadioGroup(requireContext());
+        RadioButton dark = new RadioButton(requireContext());
+        dark.setText(R.string.dark);
+        dark.setId(View.generateViewId());
+        themes.addView(dark);
+        RadioButton light = new RadioButton(requireContext());
+        light.setText(R.string.light);
+        light.setId(View.generateViewId());
+        themes.addView(light);
+        int theme = PreferenceManager.getDefaultSharedPreferences(requireContext()).getInt("app_theme", SettingsFragment.APP_THEME_DARK);
+        themes.check(theme == SettingsFragment.APP_THEME_LIGHT ? light.getId() : dark.getId());
+        themes.setOnCheckedChangeListener((group, checkedId) -> {
+            int selected = checkedId == light.getId() ? SettingsFragment.APP_THEME_LIGHT : SettingsFragment.APP_THEME_DARK;
+            PreferenceManager.getDefaultSharedPreferences(requireContext()).edit().putInt("app_theme", selected).apply();
+            AppUtils.restartActivity(requireActivity());
+        });
+        content.addView(themes);
+
+        CheckBox advanced = new CheckBox(requireContext());
+        advanced.setText(R.string.advanced_mode);
+        advanced.setChecked(PreferenceManager.getDefaultSharedPreferences(requireContext()).getBoolean("miniexe_advanced", false));
+        advanced.setOnCheckedChangeListener((button, checked) -> {
+            PreferenceManager.getDefaultSharedPreferences(requireContext()).edit().putBoolean("miniexe_advanced", checked).apply();
+            ((MainActivity)requireActivity()).updateNavigationMode();
+        });
+        content.addView(advanced);
+
+        Button advancedSettings = new Button(requireContext());
+        advancedSettings.setAllCaps(false);
+        advancedSettings.setText(R.string.advanced_settings);
+        advancedSettings.setOnClickListener(v -> {
+            advanced.setChecked(true);
+            ((MainActivity)requireActivity()).showFragment(new SettingsFragment());
+        });
+        content.addView(advancedSettings, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        TextView logs = new TextView(requireContext());
+        logs.setText(R.string.log_saved_to);
+        content.addView(logs);
+        return scroll;
+    }
+}
