+
+    public static final String HOME_CONTAINER_KEY = "miniexe_home_container";
+
+    public Container getHomeContainer(ContainerManager manager) {
+        if (manager.getContainers().isEmpty()) return null;
+        Container selected = manager.getContainerById(preferences.getInt(HOME_CONTAINER_KEY, 0));
+        return selected != null ? selected : manager.getContainers().get(0);
+    }
+
+    public void setHomeContainer(int containerId) {
+        preferences.edit().putInt(HOME_CONTAINER_KEY, containerId).apply();
+    }
+
+    public void withHomeContainer(Callback<Container> callback) {
+        ContainerManager manager = new ContainerManager(this);
+        Container existing = getHomeContainer(manager);
+        if (existing != null) {
+            callback.call(existing);
+            return;
+        }
+        if (!RootFS.find(this).isValid()) {
+            AppUtils.showToast(this, R.string.starting_up);
+            return;
+        }
+        preloaderDialog.show(R.string.creating_container);
+        JSONObject data = new JSONObject();
+        try { data.put("name", "Default"); }
+        catch (Exception ignored) {}
+        manager.createContainerAsync(data, container -> {
+            preloaderDialog.close();
+            if (container != null) {
+                setHomeContainer(container.id);
+                callback.call(container);
+            }
+            else AppUtils.showToast(this, R.string.unable_to_install_system_files);
+        });
+    }
+
+    public void openDefaultFiles() {
