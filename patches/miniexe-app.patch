+package com.winlator;
+
+import android.os.Bundle;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.fragment.app.Fragment;
+
+import com.winlator.container.Container;
+import com.winlator.container.ContainerManager;
+import com.winlator.container.Shortcut;
+
+import java.io.File;
+
+public class InstalledProgramsFragment extends Fragment {
+    private LinearLayout list;
+
+    @Nullable
+    @Override
+    public View onCreateView(@NonNull android.view.LayoutInflater inflater, @Nullable ViewGroup parent, @Nullable Bundle state) {
+        ScrollView scroll = new ScrollView(requireContext());
+        list = new LinearLayout(requireContext());
+        list.setOrientation(LinearLayout.VERTICAL);
+        int padding = (int)(16 * getResources().getDisplayMetrics().density);
+        list.setPadding(padding, padding, padding, padding);
+        scroll.addView(list);
+        return scroll;
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        requireActivity().setTitle(R.string.installed_programs);
+        list.removeAllViews();
+        MainActivity activity = (MainActivity)requireActivity();
+        ContainerManager manager = new ContainerManager(requireContext());
+        int count = 0;
+        for (Shortcut shortcut : manager.loadShortcuts(null)) {
+            if (!shortcut.file.isDirectory()) {
+                addButton(shortcut.name, () -> activity.launchProgram(shortcut.container.id, shortcut.file.getPath(), true));
+                count++;
+            }
+        }
+        for (Container container : manager.getContainers()) count += addLinks(activity, container, container.getStartMenuDir());
+        if (count == 0) {
+            TextView empty = new TextView(requireContext());
+            empty.setText(R.string.no_items_to_display);
+            list.addView(empty);
+        }
+    }
+
+    private int addLinks(MainActivity activity, Container container, File directory) {
+        File[] files = directory.listFiles();
+        if (files == null) return 0;
+        int count = 0;
+        for (File file : files) {
+            if (file.isDirectory()) count += addLinks(activity, container, file);
+            else if (file.getName().toLowerCase().endsWith(".lnk")) {
+                String name = file.getName().substring(0, file.getName().length() - 4);
+                addButton(name, () -> activity.launchProgram(container.id, file.getPath(), false));
+                count++;
+            }
+        }
+        return count;
+    }
+
+    private void addButton(String name, Runnable action) {
+        Button button = new Button(requireContext());
+        button.setAllCaps(false);
+        button.setText(name);
+        button.setOnClickListener(v -> action.run());
+        list.addView(button, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+    }
+}
