diff --git a/app/src/main/java/com/winlator/MiniHomeFragment.java b/app/src/main/java/com/winlator/MiniHomeFragment.java
new file mode 100644
index 0000000..ce4a632
--- /dev/null
+++ b/app/src/main/java/com/winlator/MiniHomeFragment.java
@@ -0,0 +1,219 @@
+package com.winlator;
+
+import android.os.Bundle;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.fragment.app.Fragment;
+import androidx.preference.PreferenceManager;
+
+import androidx.appcompat.app.AlertDialog;
+
+import com.winlator.box64.Box64Preset;
+import com.winlator.box64.Box64PresetManager;
+import com.winlator.container.Container;
+import com.winlator.container.ContainerManager;
+import com.winlator.container.Shortcut;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.File;
+import java.util.ArrayList;
+
+public class MiniHomeFragment extends Fragment {
+    private LinearLayout content;
+
+    @Nullable
+    @Override
+    public View onCreateView(@NonNull android.view.LayoutInflater inflater, @Nullable ViewGroup parent, @Nullable Bundle state) {
+        ScrollView scroll = new ScrollView(requireContext());
+        content = new LinearLayout(requireContext());
+        content.setOrientation(LinearLayout.VERTICAL);
+        int padding = (int)(16 * getResources().getDisplayMetrics().density);
+        content.setPadding(padding, padding, padding, padding);
+        scroll.addView(content);
+        return scroll;
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        requireActivity().setTitle(R.string.app_name);
+        if (!PreferenceManager.getDefaultSharedPreferences(requireContext()).getBoolean(DependencyManager.PROMPTED_KEY, false)
+                && com.winlator.xenvironment.RootFS.find(requireContext()).isValid()) {
+            ((MainActivity)requireActivity()).showFragment(new DependenciesFragment(true));
+            return;
+        }
+        populate();
+    }
+
+    private void heading(int stringId) {
+        TextView label = new TextView(requireContext());
+        label.setText(stringId);
+        label.setTextSize(20);
+        label.setPadding(0, 18, 0, 6);
+        content.addView(label);
+    }
+
+    private Button button(String label, Runnable action) {
+        Button button = new Button(requireContext());
+        button.setAllCaps(false);
+        button.setGravity(Gravity.CENTER_VERTICAL | Gravity.START);
+        button.setText(label);
+        button.setOnClickListener(v -> action.run());
+        content.addView(button, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        return button;
+    }
+
+    private void populate() {
+        if (content == null) return;
+        content.removeAllViews();
+        MainActivity activity = (MainActivity)requireActivity();
+        String lastExit = PreferenceManager.getDefaultSharedPreferences(requireContext()).getString("miniexe_last_exit", "");
+        if (!lastExit.isEmpty()) {
+            heading(R.string.last_launch);
+            TextView message = new TextView(requireContext());
+            message.setText(lastExit + "\n" + getString(R.string.log_saved_to));
+            content.addView(message);
+        }
+        button(getString(R.string.run_exe), activity::openDefaultFiles);
+        button(getString(R.string.installed_programs), () -> activity.showFragment(new InstalledProgramsFragment()));
+        button(getString(R.string.file_explorer), activity::openDefaultFiles);
+        button(getString(R.string.running_apps), () -> XServerDisplayActivity.showRunningSession(activity));
+        button(getString(R.string.dependencies), () -> activity.showFragment(new DependenciesFragment()));
+        button(getString(R.string.settings), () -> activity.showFragment(new MiniSettingsFragment()));
+
+        addContainerSection(activity);
+
+        heading(R.string.pinned_programs);
+        JSONArray pinned = readList("miniexe_pinned");
+        for (int i = 0; i < pinned.length(); i++) {
+            JSONObject item = pinned.optJSONObject(i);
+            if (item == null) continue;
+            int containerId = item.optInt("container_id");
+            String path = item.optString("path");
+            boolean shortcut = item.optBoolean("shortcut");
+            if (!new File(path).isFile()) continue;
+            button(new File(path).getName(), () -> activity.launchProgram(containerId, path, shortcut))
+                    .setOnLongClickListener(v -> { changePin(item, false); return true; });
+        }
+
+        heading(R.string.recent_applications);
+        TextView hint = new TextView(requireContext());
+        hint.setText(R.string.pin_recent_hint);
+        content.addView(hint);
+        JSONArray recent = readList("miniexe_recent");
+        for (int i = 0; i < recent.length(); i++) {
+            JSONObject item = recent.optJSONObject(i);
+            if (item == null) continue;
+            int containerId = item.optInt("container_id");
+            String path = item.optString("path");
+            boolean shortcut = item.optBoolean("shortcut");
+            if (!new File(path).isFile()) continue;
+            button(new File(path).getName(), () -> activity.launchProgram(containerId, path, shortcut))
+                    .setOnLongClickListener(v -> { changePin(item, true); return true; });
+        }
+
+        heading(R.string.installed_programs);
+        ContainerManager manager = new ContainerManager(requireContext());
+        ArrayList<Shortcut> shortcuts = manager.loadShortcuts(null);
+        int displayed = 0;
+        for (Shortcut shortcut : shortcuts) {
+            if (shortcut.file.isDirectory()) continue;
+            button(shortcut.name, () -> activity.launchProgram(shortcut.container.id, shortcut.file.getPath(), true));
+            if (++displayed >= 12) break;
+        }
+        for (Container container : manager.getContainers()) {
+            displayed = addStartMenuLinks(activity, container, container.getStartMenuDir(), displayed);
+            if (displayed >= 20) break;
+        }
+        if (displayed == 0) {
+            TextView empty = new TextView(requireContext());
+            empty.setText(R.string.no_items_to_display);
+            content.addView(empty);
+        }
+    }
+
+    private void addContainerSection(MainActivity activity) {
+        heading(R.string.container);
+        ContainerManager manager = new ContainerManager(requireContext());
+        Container container = activity.getHomeContainer(manager);
+        TextView summary = new TextView(requireContext());
+        if (container == null) summary.setText(R.string.no_container_yet);
+        else {
+            Box64Preset preset = Box64PresetManager.getPreset(requireContext(), container.getBox64Preset());
+            summary.setText(getString(R.string.container_summary,
+                    container.getName(),
+                    container.getScreenSize(),
+                    container.getGraphicsDriver(),
+                    container.getDXWrapper(),
+                    preset != null ? preset.name : container.getBox64Preset()));
+            if (XServerDisplayActivity.getActiveContainerId() == container.id) {
+                summary.append("\n" + getString(R.string.container_running_note));
+            }
+        }
+        content.addView(summary);
+
+        button(getString(R.string.container_settings), activity::openContainerSettings);
+
+        ArrayList<Container> containers = manager.getContainers();
+        if (container != null && containers.size() > 1) {
+            button(getString(R.string.switch_container), () -> {
+                String[] names = new String[containers.size()];
+                int checked = 0;
+                for (int i = 0; i < containers.size(); i++) {
+                    names[i] = containers.get(i).getName();
+                    if (containers.get(i).id == container.id) checked = i;
+                }
+                new AlertDialog.Builder(requireContext())
+                        .setTitle(R.string.switch_container)
+                        .setSingleChoiceItems(names, checked, (dialog, which) -> {
+                            activity.setHomeContainer(containers.get(which).id);
+                            dialog.dismiss();
+                            populate();
+                        })
+                        .setNegativeButton(android.R.string.cancel, null)
+                        .show();
+            });
+        }
+    }
+
+    private JSONArray readList(String key) {
+        try { return new JSONArray(PreferenceManager.getDefaultSharedPreferences(requireContext()).getString(key, "[]")); }
+        catch (Exception e) { return new JSONArray(); }
+    }
+
+    private void changePin(JSONObject selected, boolean add) {
+        JSONArray current = readList("miniexe_pinned");
+        JSONArray next = new JSONArray();
+        if (add) next.put(selected);
+        for (int i = 0; i < current.length(); i++) {
+            JSONObject item = current.optJSONObject(i);
+            if (item != null && !item.optString("path").equals(selected.optString("path"))) next.put(item);
+        }
+        PreferenceManager.getDefaultSharedPreferences(requireContext()).edit().putString("miniexe_pinned", next.toString()).apply();
+        populate();
+    }
+
+    private int addStartMenuLinks(MainActivity activity, Container container, File directory, int count) {
+        File[] files = directory.listFiles();
+        if (files == null) return count;
+        for (File file : files) {
+            if (count >= 20) break;
+            if (file.isDirectory()) count = addStartMenuLinks(activity, container, file, count);
+            else if (file.getName().toLowerCase().endsWith(".lnk")) {
+                button(file.getName().substring(0, file.getName().length() - 4), () -> activity.launchProgram(container.id, file.getPath(), false));
+                count++;
+            }
+        }
+        return count;
+    }
+}
