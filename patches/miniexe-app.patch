diff --git a/app/src/main/java/com/winlator/DependenciesFragment.java b/app/src/main/java/com/winlator/DependenciesFragment.java
new file mode 100644
index 0000000..8c26cda
--- /dev/null
+++ b/app/src/main/java/com/winlator/DependenciesFragment.java
@@ -0,0 +1,426 @@
+package com.winlator;
+
+import android.app.Activity;
+import android.os.Bundle;
+import android.text.format.Formatter;
+import android.view.Gravity;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.CheckBox;
+import android.widget.LinearLayout;
+import android.widget.ProgressBar;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.appcompat.app.AlertDialog;
+import androidx.fragment.app.Fragment;
+import androidx.preference.PreferenceManager;
+
+import com.winlator.container.Container;
+import com.winlator.container.ContainerManager;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/** Optional dependency picker. Nothing here is required; Skip leaves the container untouched. */
+public class DependenciesFragment extends Fragment {
+    private final boolean firstRun;
+    private LinearLayout content;
+    private DependencyManager.Catalog catalog;
+    private final Map<String, CheckBox> checks = new HashMap<>();
+    private final Map<String, TextView> details = new HashMap<>();
+    private final Map<String, DependencyManager.Status> statuses = new HashMap<>();
+    private final Map<String, Long> remoteSizes = new HashMap<>();
+    private final ExecutorService executor = Executors.newSingleThreadExecutor();
+    private boolean updating;
+
+    public DependenciesFragment() {
+        this(false);
+    }
+
+    public DependenciesFragment(boolean firstRun) {
+        this.firstRun = firstRun;
+    }
+
+    @Nullable
+    @Override
+    public View onCreateView(@NonNull LayoutInflater inflater, @Nullable ViewGroup parent, @Nullable Bundle state) {
+        catalog = DependencyManager.loadCatalog(requireContext());
+        ScrollView scroll = new ScrollView(requireContext());
+        content = new LinearLayout(requireContext());
+        content.setOrientation(LinearLayout.VERTICAL);
+        int padding = dp(16);
+        content.setPadding(padding, padding, padding, padding);
+        scroll.addView(content);
+        PreferenceManager.getDefaultSharedPreferences(requireContext()).edit().putBoolean(DependencyManager.PROMPTED_KEY, true).apply();
+        return scroll;
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        requireActivity().setTitle(R.string.dependencies);
+        populate();
+    }
+
+    @Override
+    public void onDestroy() {
+        super.onDestroy();
+        executor.shutdownNow();
+    }
+
+    private int dp(int value) {
+        return (int)(value * getResources().getDisplayMetrics().density);
+    }
+
+    private TextView text(CharSequence value, int sizeSp) {
+        TextView view = new TextView(requireContext());
+        view.setText(value);
+        if (sizeSp > 0) view.setTextSize(sizeSp);
+        content.addView(view);
+        return view;
+    }
+
+    private Button button(int label, View.OnClickListener listener) {
+        Button button = new Button(requireContext());
+        button.setAllCaps(false);
+        button.setText(label);
+        button.setOnClickListener(listener);
+        content.addView(button, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        return button;
+    }
+
+    private void populate() {
+        if (content == null) return;
+        content.removeAllViews();
+        checks.clear();
+        details.clear();
+        statuses.clear();
+
+        MainActivity activity = (MainActivity)requireActivity();
+        ContainerManager manager = new ContainerManager(requireContext());
+        Container container = activity.getHomeContainer(manager);
+
+        text(getString(R.string.dependencies), 22);
+        text(getString(R.string.deps_intro), 0);
+        text(container != null ? getString(R.string.deps_target_container, container.getName()) : getString(R.string.deps_no_container), 0);
+        if (container != null && XServerDisplayActivity.getActiveContainerId() == container.id) {
+            text(getString(R.string.deps_session_running), 0);
+        }
+
+        DependencyManager.Snapshot snapshot = container != null ? DependencyManager.snapshot(container) : null;
+        updating = true;
+        for (Map.Entry<String, String> category : catalog.categories.entrySet()) {
+            TextView heading = text(category.getValue(), 18);
+            heading.setPadding(0, dp(14), 0, dp(4));
+            for (DependencyManager.Item item : catalog.items) {
+                if (item.category.equals(category.getKey())) addItem(item, container, snapshot);
+            }
+        }
+        updating = false;
+        refreshDetails();
+
+        LinearLayout.LayoutParams spacer = new LinearLayout.LayoutParams(1, dp(12));
+        content.addView(new View(requireContext()), spacer);
+        button(R.string.deps_install_selected, v -> installSelected());
+        button(firstRun ? R.string.skip : R.string.done, v -> activity.showFragment(new MiniHomeFragment()));
+        long cache = DependencyManager.cacheSize(requireContext());
+        if (cache > 0) {
+            button(R.string.deps_clear_cache, v -> {
+                DependencyManager.clearCache(requireContext());
+                populate();
+            }).setText(getString(R.string.deps_clear_cache_size, Formatter.formatShortFileSize(requireContext(), cache)));
+        }
+        fetchSizes();
+    }
+
+    private void addItem(DependencyManager.Item item, Container container, DependencyManager.Snapshot snapshot) {
+        DependencyManager.Status status = snapshot != null
+                ? DependencyManager.status(requireContext(), item, snapshot)
+                : new DependencyManager.Status(item.isInfo() ? DependencyManager.State.INFO : DependencyManager.State.NOT_INSTALLED, item.note);
+        statuses.put(item.id, status);
+
+        if (item.isInfo()) {
+            TextView name = text(item.name, 16);
+            name.setPadding(dp(8), dp(6), 0, 0);
+            TextView note = text(item.note, 0);
+            note.setPadding(dp(8), 0, 0, dp(4));
+            return;
+        }
+
+        CheckBox check = new CheckBox(requireContext());
+        check.setText(item.name);
+        check.setGravity(Gravity.CENTER_VERTICAL);
+        if (item.isWinComponent()) {
+            check.setChecked(container != null ? DependencyManager.isWinComponentEnabled(container, item) : false);
+        }
+        else if (status.state == DependencyManager.State.INSTALLED || isReplacedByInstalled(item)) {
+            check.setChecked(true);
+            check.setEnabled(false);
+        }
+        check.setOnCheckedChangeListener((button, checked) -> onToggled(item, checked));
+        content.addView(check);
+        checks.put(item.id, check);
+
+        TextView detail = new TextView(requireContext());
+        detail.setPadding(dp(32), 0, 0, dp(6));
+        content.addView(detail);
+        details.put(item.id, detail);
+    }
+
+    private boolean isReplacedByInstalled(DependencyManager.Item item) {
+        for (DependencyManager.Item other : catalog.items) {
+            DependencyManager.Status status = statuses.get(other.id);
+            if (other.replaces.contains(item.id) && status != null && status.state == DependencyManager.State.INSTALLED) return true;
+        }
+        return false;
+    }
+
+    private boolean isInstalled(String id) {
+        DependencyManager.Status status = statuses.get(id);
+        return status != null && status.state == DependencyManager.State.INSTALLED;
+    }
+
+    /** Selection rules: requirements are selected too, and conflicting items are deselected. */
+    private void onToggled(DependencyManager.Item item, boolean checked) {
+        if (updating) return;
+        updating = true;
+        if (checked) {
+            for (String required : item.requires) {
+                CheckBox box = checks.get(required);
+                if (box != null && box.isEnabled()) box.setChecked(true);
+            }
+            for (String conflict : item.conflicts) {
+                CheckBox box = checks.get(conflict);
+                if (box != null && box.isEnabled()) box.setChecked(false);
+            }
+        }
+        else {
+            for (DependencyManager.Item other : catalog.items) {
+                CheckBox box = checks.get(other.id);
+                if (other.requires.contains(item.id) && box != null && box.isEnabled() && !item.isWinComponent()) box.setChecked(false);
+            }
+        }
+        updating = false;
+        refreshDetails();
+    }
+
+    private void refreshDetails() {
+        if (!isAdded()) return;
+        for (DependencyManager.Item item : catalog.items) {
+            TextView detail = details.get(item.id);
+            if (detail == null) continue;
+            DependencyManager.Status status = statuses.get(item.id);
+            StringBuilder sb = new StringBuilder();
+            switch (status.state) {
+                case INSTALLED: sb.append(getString(R.string.deps_installed)); break;
+                case PENDING_RESTART: sb.append(getString(R.string.deps_pending_restart)); break;
+                case FAILED: sb.append(getString(R.string.deps_failed, status.detail)); break;
+                default:
+                    if (isReplacedByInstalled(item)) sb.append(getString(R.string.deps_replaced));
+                    else if (item.isWinComponent()) sb.append(getString(R.string.deps_bundled));
+                    else sb.append(getString(R.string.deps_not_installed));
+            }
+            if (item.isInstaller() && status.state != DependencyManager.State.INSTALLED && !isReplacedByInstalled(item)) {
+                sb.append(" · ");
+                if (DependencyManager.isCached(requireContext(), item)) {
+                    sb.append(getString(R.string.deps_cached, Formatter.formatShortFileSize(requireContext(), DependencyManager.cachedSize(requireContext(), item))));
+                }
+                else {
+                    Long size = remoteSizes.get(item.id);
+                    sb.append(size == null ? getString(R.string.deps_size_checking)
+                            : size < 0 ? getString(R.string.deps_size_unknown)
+                            : getString(R.string.deps_download_size, Formatter.formatShortFileSize(requireContext(), size)));
+                }
+            }
+            if (!item.note.isEmpty()) sb.append("\n").append(item.note);
+            detail.setText(sb);
+        }
+    }
+
+    private void fetchSizes() {
+        Activity activity = requireActivity();
+        for (DependencyManager.Item item : catalog.items) {
+            if (!item.isInstaller() || remoteSizes.containsKey(item.id) || isInstalled(item.id)) continue;
+            if (DependencyManager.isCached(requireContext(), item)) continue;
+            executor.execute(() -> {
+                long total = 0;
+                for (DependencyManager.Download download : item.downloads) {
+                    long size = DependencyManager.remoteSize(download);
+                    if (size < 0) { total = -1; break; }
+                    total += size;
+                }
+                final long result = total;
+                activity.runOnUiThread(() -> {
+                    remoteSizes.put(item.id, result);
+                    refreshDetails();
+                });
+            });
+        }
+    }
+
+    private void installSelected() {
+        MainActivity activity = (MainActivity)requireActivity();
+        activity.withHomeContainer(container -> {
+            if (!isAdded()) return;
+            DependencyManager.Snapshot snapshot = DependencyManager.snapshot(container);
+            boolean wincomponentsChanged = false;
+            List<DependencyManager.Item> installers = new ArrayList<>();
+            Set<String> wanted = new LinkedHashSet<>();
+            for (DependencyManager.Item item : catalog.items) {
+                CheckBox box = checks.get(item.id);
+                if (box == null) continue;
+                if (item.isWinComponent()) {
+                    boolean enabled = DependencyManager.isWinComponentEnabled(container, item);
+                    if (box.isChecked() != enabled) {
+                        DependencyManager.setWinComponent(container, item, box.isChecked());
+                        wincomponentsChanged = true;
+                    }
+                }
+                else if (item.isInstaller() && box.isEnabled() && box.isChecked()) {
+                    if (DependencyManager.status(requireContext(), item, snapshot).state != DependencyManager.State.INSTALLED) wanted.add(item.id);
+                }
+            }
+            for (DependencyManager.Item item : catalog.items) if (wanted.contains(item.id)) installers.add(item);
+
+            if (installers.isEmpty()) {
+                new AlertDialog.Builder(requireContext())
+                        .setMessage(wincomponentsChanged ? R.string.deps_components_saved : R.string.deps_nothing_selected)
+                        .setPositiveButton(android.R.string.ok, null)
+                        .show();
+                populate();
+                return;
+            }
+
+            DependencyManager.Item mono = catalog.get("mono");
+            boolean monoInstalled = mono != null && DependencyManager.status(requireContext(), mono, snapshot).state == DependencyManager.State.INSTALLED;
+            List<DependencyManager.Item> toDownload = new ArrayList<>(installers);
+            boolean anyRemovesMono = false;
+            for (DependencyManager.Item item : installers) anyRemovesMono |= item.removeMono;
+            final boolean needsMonoRemoval = anyRemovesMono;
+            if (needsMonoRemoval && monoInstalled && !toDownload.contains(mono)) toDownload.add(0, mono);
+
+            downloadAll(toDownload, (errors, failed) -> {
+                List<DependencyManager.Item> ready = new ArrayList<>();
+                for (DependencyManager.Item item : installers) {
+                    boolean missingRequirement = false;
+                    for (String req : item.requires) missingRequirement |= failed.contains(req);
+                    if (!failed.contains(item.id) && !missingRequirement) ready.add(item);
+                }
+                boolean monoUsable = !(needsMonoRemoval && monoInstalled && failed.contains("mono"));
+                if (!monoUsable) {
+                    ready.removeIf(item -> item.removeMono);
+                    errors.add(getString(R.string.deps_mono_cache_missing));
+                }
+                Runnable start = () -> {
+                    if (ready.isEmpty()) { populate(); return; }
+                    try {
+                        File script = DependencyManager.writeInstallScript(requireContext(), container, catalog, ready, monoInstalled);
+                        DependencyManager.launch(requireActivity(), container, script);
+                    }
+                    catch (Exception e) {
+                        errors.add(e.toString());
+                        showErrors(errors, null);
+                    }
+                };
+                if (errors.isEmpty()) start.run();
+                else showErrors(errors, ready.isEmpty() ? null : start);
+            });
+        });
+    }
+
+    private void showErrors(List<String> errors, @Nullable Runnable continueAction) {
+        if (!isAdded()) return;
+        AlertDialog.Builder builder = new AlertDialog.Builder(requireContext())
+                .setTitle(R.string.deps_download_errors)
+                .setMessage(String.join("\n\n", errors));
+        if (continueAction != null) {
+            builder.setPositiveButton(R.string.deps_install_remaining, (d, w) -> continueAction.run());
+            builder.setNegativeButton(android.R.string.cancel, (d, w) -> populate());
+        }
+        else builder.setPositiveButton(android.R.string.ok, (d, w) -> populate());
+        builder.show();
+    }
+
+    private interface DownloadResult {
+        void done(List<String> errors, Set<String> failed);
+    }
+
+    private void downloadAll(List<DependencyManager.Item> items, DownloadResult result) {
+        Activity activity = requireActivity();
+        List<DependencyManager.Download> pending = new ArrayList<>();
+        List<DependencyManager.Item> owners = new ArrayList<>();
+        for (DependencyManager.Item item : items) {
+            for (DependencyManager.Download download : item.downloads) {
+                if (!DependencyManager.isCached(activity, item, download)) {
+                    pending.add(download);
+                    owners.add(item);
+                }
+            }
+        }
+        if (pending.isEmpty()) {
+            result.done(new ArrayList<>(), new LinkedHashSet<>());
+            return;
+        }
+
+        AtomicBoolean cancelled = new AtomicBoolean();
+        LinearLayout layout = new LinearLayout(activity);
+        layout.setOrientation(LinearLayout.VERTICAL);
+        layout.setPadding(dp(20), dp(16), dp(20), 0);
+        TextView label = new TextView(activity);
+        ProgressBar bar = new ProgressBar(activity, null, android.R.attr.progressBarStyleHorizontal);
+        bar.setMax(1000);
+        layout.addView(label);
+        layout.addView(bar);
+        AlertDialog dialog = new AlertDialog.Builder(activity)
+                .setTitle(R.string.deps_downloading)
+                .setView(layout)
+                .setCancelable(false)
+                .setNegativeButton(android.R.string.cancel, (d, w) -> cancelled.set(true))
+                .show();
+
+        executor.execute(() -> {
+            List<String> errors = new ArrayList<>();
+            Set<String> failed = new LinkedHashSet<>();
+            for (int i = 0; i < pending.size(); i++) {
+                DependencyManager.Item item = owners.get(i);
+                DependencyManager.Download download = pending.get(i);
+                if (failed.contains(item.id)) continue;
+                if (cancelled.get()) { failed.add(item.id); continue; }
+                final String caption = (i + 1) + "/" + pending.size() + "  " + item.name + "\n" + download.file;
+                activity.runOnUiThread(() -> { label.setText(caption); bar.setIndeterminate(true); });
+                String error = DependencyManager.download(activity, item, download, cancelled, (done, total) -> {
+                    if (total <= 0) return;
+                    int value = (int)(done * 1000 / total);
+                    activity.runOnUiThread(() -> {
+                        bar.setIndeterminate(false);
+                        bar.setProgress(value);
+                        label.setText(caption + "\n" + Formatter.formatShortFileSize(activity, done) + " / " + Formatter.formatShortFileSize(activity, total));
+                    });
+                });
+                if (error != null) {
+                    failed.add(item.id);
+                    if (!cancelled.get()) errors.add(item.name + ": " + error);
+                }
+            }
+            activity.runOnUiThread(() -> {
+                try { dialog.dismiss(); } catch (Exception ignored) {}
+                if (!isAdded()) return;
+                if (cancelled.get()) { populate(); return; }
+                result.done(errors, failed);
+            });
+        });
+    }
+}
