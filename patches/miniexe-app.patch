+    private static OutputStream openDownloadsLog(Context context, String legacyPath) throws IOException {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) {
+            File file = new File(legacyPath);
+            File parent = file.getParentFile();
+            if (parent != null && !parent.isDirectory()) parent.mkdirs();
+            return new FileOutputStream(file, false);
+        }
+        String relativePath = Environment.DIRECTORY_DOWNLOADS + "/MiniEXE/";
+        Uri collection = MediaStore.Downloads.EXTERNAL_CONTENT_URI;
+        Uri item = null;
+        try (Cursor cursor = context.getContentResolver().query(collection,
+                new String[]{MediaStore.MediaColumns._ID},
+                MediaStore.MediaColumns.RELATIVE_PATH + "=? AND " + MediaStore.MediaColumns.DISPLAY_NAME + "=?",
+                new String[]{relativePath, "logs.txt"}, null)) {
+            if (cursor != null && cursor.moveToFirst()) item = ContentUris.withAppendedId(collection, cursor.getLong(0));
+        }
+        if (item == null) {
+            ContentValues values = new ContentValues();
+            values.put(MediaStore.MediaColumns.DISPLAY_NAME, "logs.txt");
+            values.put(MediaStore.MediaColumns.MIME_TYPE, "text/plain");
+            values.put(MediaStore.MediaColumns.RELATIVE_PATH, relativePath);
+            item = context.getContentResolver().insert(collection, values);
+        }
+        if (item == null) throw new IOException("Unable to create Downloads log");
+        OutputStream output = context.getContentResolver().openOutputStream(item, "wt");
+        if (output == null) throw new IOException("Unable to open Downloads log");
+        return output;
+    }
