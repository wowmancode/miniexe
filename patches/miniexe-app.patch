+/**
+ * Optional Windows dependencies for a MiniEXE container.
+ *
+ * Two kinds are supported: Winlator's bundled "wincomponents" (native DLL sets shipped in the
+ * APK and applied at session start) and official redistributable installers that are downloaded,
+ * checked against a pinned SHA-256, cached, and run inside the container's Wine session through a
+ * generated batch file. Installed status is always derived from the container's files and
+ * registry, never from the fact that an installer was started.
+ */
+public final class DependencyManager {
+    public static final String PROMPTED_KEY = "miniexe_deps_prompted";
+    private static final String INSTALL_DIR = "miniexe";
+
+    public enum State { INSTALLED, PENDING_RESTART, FAILED, NOT_INSTALLED, INFO }
+
+    public static final class Download {
+        public final String url;
+        public final String sha256;
+        public final String file;
+        public final boolean extractCab;
+
+        Download(JSONObject json) {
+            url = json.optString("url");
+            sha256 = json.optString("sha256").toLowerCase(Locale.ENGLISH);
+            file = json.optString("file");
+            extractCab = json.optBoolean("extractCab");
+        }
+    }
+
+    public static final class Item {
+        public final String id;
+        public final String name;
+        public final String category;
+        public final String type;
+        public final String note;
+        public final String wincomponent;
+        public final String winver;
+        public final String env;
+        public final boolean removeMono;
+        public final List<String> requires;
+        public final List<String> replaces;
+        public final List<String> conflicts;
+        public final List<Download> downloads = new ArrayList<>();
+        public final List<String> commands;
+        public final Map<String, List<String>> overrides = new LinkedHashMap<>();
+        public final JSONObject verify;
+
+        Item(JSONObject json) {
+            id = json.optString("id");
+            name = json.optString("name");
+            category = json.optString("category");
+            type = json.optString("type");
+            note = json.optString("note", "");
+            wincomponent = json.optString("wincomponent", "");
+            winver = json.optString("winver", "");
+            env = json.optString("env", "");
+            removeMono = json.optBoolean("removeMono");
+            requires = strings(json.optJSONArray("requires"));
+            replaces = strings(json.optJSONArray("replaces"));
+            conflicts = strings(json.optJSONArray("conflicts"));
+            commands = strings(json.optJSONArray("commands"));
+            JSONArray dl = json.optJSONArray("downloads");
+            if (dl != null) for (int i = 0; i < dl.length(); i++) downloads.add(new Download(dl.optJSONObject(i)));
+            JSONObject ov = json.optJSONObject("overrides");
+            if (ov != null) {
+                JSONArray names = ov.names();
+                if (names != null) for (int i = 0; i < names.length(); i++) {
+                    String mode = names.optString(i);
+                    overrides.put(mode, strings(ov.optJSONArray(mode)));
+                }
+            }
+            verify = json.optJSONObject("verify");
+        }
+
+        public boolean isInstaller() { return "installer".equals(type); }
+        public boolean isWinComponent() { return "wincomponent".equals(type); }
+        public boolean isInfo() { return "info".equals(type); }
+    }
+
+    public static final class Catalog {
+        public final LinkedHashMap<String, String> categories = new LinkedHashMap<>();
+        public final List<Item> items = new ArrayList<>();
+
+        public Item get(String id) {
+            for (Item item : items) if (item.id.equals(id)) return item;
+            return null;
+        }
+    }
+
+    public static final class Status {
+        public final State state;
+        public final String detail;
+
+        Status(State state, String detail) {
+            this.state = state;
+            this.detail = detail;
+        }
+    }
+
+    private DependencyManager() {}
+
+    private static List<String> strings(JSONArray array) {
+        ArrayList<String> list = new ArrayList<>();
+        if (array != null) for (int i = 0; i < array.length(); i++) list.add(array.optString(i));
+        return list;
+    }
+
+    public static Catalog loadCatalog(Context context) {
+        Catalog catalog = new Catalog();
+        try {
+            JSONObject json = new JSONObject(FileUtils.readString(context, "miniexe/dependencies.json"));
+            JSONArray categories = json.getJSONArray("categories");
+            for (int i = 0; i < categories.length(); i++) {
+                JSONObject category = categories.getJSONObject(i);
+                catalog.categories.put(category.getString("id"), category.getString("name"));
+            }
+            JSONArray items = json.getJSONArray("items");
+            for (int i = 0; i < items.length(); i++) catalog.items.add(new Item(items.getJSONObject(i)));
+        }
+        catch (Exception ignored) {}
+        return catalog;
+    }
+
+    // ---------------------------------------------------------------- verification
+
+    /** Read-only snapshot of the container's Windows directory and HKLM registry. */
+    public static final class Snapshot {
+        final File windowsDir;
+        final File driveC;
+        final Map<String, Map<String, String>> registry;
+        final String registryText;
+        final KeyValueSet wincomponents;
+        final boolean pendingWinComponents;
+
+        Snapshot(Container container) {
+            driveC = new File(container.getRootDir(), ".wine/drive_c");
+            windowsDir = new File(driveC, "windows");
+            File systemReg = new File(container.getRootDir(), ".wine/system.reg");
+            registry = new HashMap<>();
+            registryText = parseRegistry(systemReg, registry);
+            wincomponents = new KeyValueSet(container.getWinComponents());
+            String applied = container.getExtra("wincomponents", "");
+            pendingWinComponents = !container.getWinComponents().equals(applied);
+        }
+    }
+
+    public static Snapshot snapshot(Container container) {
+        return new Snapshot(container);
+    }
+
+    private static String parseRegistry(File file, Map<String, Map<String, String>> out) {
+        StringBuilder text = new StringBuilder();
+        if (!file.isFile()) return "";
+        try (BufferedReader reader = new BufferedReader(new FileReader(file))) {
+            String line;
+            Map<String, String> current = null;
+            while ((line = reader.readLine()) != null) {
+                if (line.startsWith("[")) {
+                    int end = line.lastIndexOf(']');
+                    if (end > 0) {
+                        String key = line.substring(1, end).replace("\\\\", "\\").toLowerCase(Locale.ENGLISH);
+                        current = new HashMap<>();
+                        out.put(key, current);
+                    }
+                }
+                else if (current != null && line.startsWith("\"")) {
+                    int eq = line.indexOf("\"=");
+                    if (eq > 0) current.put(line.substring(1, eq).toLowerCase(Locale.ENGLISH), line.substring(eq + 2));
+                    if (line.contains("DisplayName")) text.append(line).append('\n');
+                }
+            }
+        }
+        catch (IOException ignored) {}
+        return text.toString().toLowerCase(Locale.ENGLISH);
+    }
+
+    private static Integer regDword(Snapshot snapshot, String key, String name) {
+        String lower = key.toLowerCase(Locale.ENGLISH);
+        String[] candidates = {lower, lower.replaceFirst("^software\\\\", "software\\\\wow6432node\\\\")};
+        for (String candidate : candidates) {
+            Map<String, String> values = snapshot.registry.get(candidate);
+            if (values == null) continue;
+            String value = values.get(name.toLowerCase(Locale.ENGLISH));
+            if (value != null && value.startsWith("dword:")) {
+                try { return (int)Long.parseLong(value.substring(6), 16); }
+                catch (NumberFormatException ignored) {}
+            }
+        }
+        return null;
+    }
+
+    /** Resolves a path below C:\windows case-insensitively, as Windows would. */
+    private static File resolve(File base, String relative) {
+        File current = base;
+        for (String part : relative.split("/")) {
+            if (part.isEmpty()) continue;
+            File exact = new File(current, part);
+            if (exact.exists()) { current = exact; continue; }
+            File[] children = current.listFiles();
+            File match = null;
+            if (children != null) for (File child : children) if (child.getName().equalsIgnoreCase(part)) { match = child; break; }
+            if (match == null) return null;
+            current = match;
+        }
+        return current;
+    }
+
+    /** True when the file exists and is not one of Wine's builtin or placeholder DLLs. */
+    static boolean isNativeFile(File file) {
+        if (file == null || !file.isFile()) return false;
+        byte[] header = new byte[0x80];
+        try (FileInputStream in = new FileInputStream(file)) {
+            int read = in.read(header);
+            if (read < 0x60) return true;
+        }
+        catch (IOException e) { return false; }
+        String marker = new String(header, 0x40, 0x40, StandardCharsets.ISO_8859_1);
+        return !marker.startsWith("Wine builtin DLL") && !marker.startsWith("Wine placeholder DLL");
+    }
+
+    private static boolean verified(Item item, Snapshot snapshot) {
+        JSONObject verify = item.verify;
+        if (verify == null) return false;
+        JSONArray native_ = verify.optJSONArray("native");
+        if (native_ != null) for (int i = 0; i < native_.length(); i++) {
+            if (!isNativeFile(resolve(snapshot.windowsDir, native_.optString(i)))) return false;
+        }
+        JSONArray files = verify.optJSONArray("files");
+        if (files != null) for (int i = 0; i < files.length(); i++) {
+            if (resolve(snapshot.windowsDir, files.optString(i)) == null) return false;
+        }
+        JSONObject dword = verify.optJSONObject("regDword");
+        if (dword != null) {
+            Integer value = regDword(snapshot, dword.optString("key"), dword.optString("name"));
+            if (value == null || (value & 0xffffffffL) < dword.optLong("min")) return false;
+        }
+        String text = verify.optString("regText", "");
+        if (!text.isEmpty() && !snapshot.registryText.contains(text.toLowerCase(Locale.ENGLISH))) return false;
+        return native_ != null || files != null || dword != null || !text.isEmpty();
+    }
+
+    public static Status status(Context context, Item item, Snapshot snapshot) {
+        if (item.isInfo()) return new Status(State.INFO, item.note);
+        boolean ok = verified(item, snapshot);
+        if (item.isWinComponent()) {
+            boolean enabled = "1".equals(snapshot.wincomponents.get(item.wincomponent));
+            if (enabled && ok) return new Status(State.INSTALLED, null);
+            if (enabled) return new Status(State.PENDING_RESTART, null);
+            if (ok && snapshot.pendingWinComponents) return new Status(State.PENDING_RESTART, null);
+            return new Status(State.NOT_INSTALLED, null);
+        }
+        if (ok) return new Status(State.INSTALLED, null);
+        File statusFile = new File(snapshot.driveC, INSTALL_DIR + "/status/" + item.id + ".txt");
+        if (statusFile.isFile()) {
+            String code = FileUtils.readString(statusFile).trim();
+            return new Status(State.FAILED, code);
+        }
+        return new Status(State.NOT_INSTALLED, null);
+    }
+
+    public static boolean isWinComponentEnabled(Container container, Item item) {
+        return "1".equals(new KeyValueSet(container.getWinComponents()).get(item.wincomponent));
+    }
+
+    /** Updates a bundled component. It is extracted or removed when the container next starts. */
+    public static void setWinComponent(Container container, Item item, boolean enabled) {
+        KeyValueSet set = new KeyValueSet(container.getWinComponents());
+        set.put(item.wincomponent, enabled ? "1" : "0");
+        container.setWinComponents(set.toString());
+        container.saveData();
+    }
+
+    // ---------------------------------------------------------------- cache and downloads
+
+    public static File cacheDir(Context context) {
+        return new File(context.getFilesDir(), "miniexe/dependency-cache");
+    }
+
+    private static File cacheFile(Context context, Item item, Download download) {
+        return new File(cacheDir(context), item.id + "/" + download.file);
+    }
+
+    public static boolean isCached(Context context, Item item, Download download) {
+        File file = cacheFile(context, item, download);
+        File marker = new File(file.getPath() + ".sha256");
+        if (!file.isFile() || !marker.isFile()) return false;
+        if (!download.sha256.equals(FileUtils.readString(marker).trim())) return false;
+        return !download.extractCab || cabFile(file).isFile();
+    }
+
+    public static boolean isCached(Context context, Item item) {
+        for (Download download : item.downloads) if (!isCached(context, item, download)) return false;
+        return true;
+    }
+
+    public static long cachedSize(Context context, Item item) {
+        long total = 0;
+        for (Download download : item.downloads) total += cacheFile(context, item, download).length();
+        return total;
+    }
+
+    public static long cacheSize(Context context) {
+        return directorySize(cacheDir(context));
+    }
+
+    private static long directorySize(File dir) {
+        File[] files = dir.listFiles();
+        long total = 0;
+        if (files != null) for (File file : files) total += file.isDirectory() ? directorySize(file) : file.length();
+        return total;
+    }
+
+    public static void clearCache(Context context) {
+        FileUtils.delete(cacheDir(context));
+    }
+
+    private static File cabFile(File exe) {
+        String path = exe.getPath();
+        int dot = path.lastIndexOf('.');
+        return new File((dot > 0 ? path.substring(0, dot) : path) + ".cab");
+    }
+
+    private static HttpURLConnection open(String url, String method) throws IOException {
+        HttpURLConnection connection = null;
+        String current = url;
+        for (int redirects = 0; redirects < 8; redirects++) {
+            connection = (HttpURLConnection)new URL(current).openConnection();
+            connection.setRequestMethod(method);
+            connection.setInstanceFollowRedirects(false);
+            connection.setConnectTimeout(20000);
+            connection.setReadTimeout(30000);
+            connection.setRequestProperty("User-Agent", "MiniEXE");
+            int code = connection.getResponseCode();
+            if (code >= 300 && code < 400) {
+                String location = connection.getHeaderField("Location");
+                connection.disconnect();
+                if (location == null) throw new IOException("HTTP " + code);
+                current = new URL(new URL(current), location).toString();
+                if (!current.startsWith("https://")) throw new IOException("Refused non-HTTPS redirect");
+                continue;
+            }
+            return connection;
+        }
+        throw new IOException("Too many redirects");
+    }
+
+    /** Download size in bytes, or -1 when the server does not report it. */
+    public static long remoteSize(Download download) {
+        HttpURLConnection connection = null;
+        try {
+            connection = open(download.url, "HEAD");
+            if (connection.getResponseCode() != HttpURLConnection.HTTP_OK) return -1;
+            return connection.getContentLengthLong();
+        }
+        catch (Exception e) { return -1; }
+        finally { if (connection != null) connection.disconnect(); }
+    }
+
+    public interface Progress {
+        void update(long done, long total);
+    }
+
+    /** Downloads one file and checks its SHA-256. Returns null on success or an error message. */
+    public static String download(Context context, Item item, Download download, AtomicBoolean cancelled, Progress progress) {
+        File target = cacheFile(context, item, download);
+        File parent = target.getParentFile();
+        if (parent != null && !parent.isDirectory()) parent.mkdirs();
+        File partial = new File(target.getPath() + ".part");
+        HttpURLConnection connection = null;
+        try {
+            connection = open(download.url, "GET");
+            int code = connection.getResponseCode();
+            if (code != HttpURLConnection.HTTP_OK) return download.file + ": HTTP " + code;
+            long total = connection.getContentLengthLong();
+            MessageDigest digest = MessageDigest.getInstance("SHA-256");
+            long done = 0;
+            try (InputStream in = new BufferedInputStream(connection.getInputStream(), 65536);
+                 OutputStream out = new FileOutputStream(partial)) {
+                byte[] buffer = new byte[65536];
+                int read;
+                while ((read = in.read(buffer)) != -1) {
+                    if (cancelled.get()) return context.getString(R.string.deps_cancelled);
+                    out.write(buffer, 0, read);
+                    digest.update(buffer, 0, read);
+                    done += read;
+                    progress.update(done, total);
+                }
+            }
+            String actual = hex(digest.digest());
+            if (!actual.equals(download.sha256)) {
+                partial.delete();
+                return context.getString(R.string.deps_checksum_mismatch, download.file);
+            }
+            if (target.exists()) target.delete();
+            if (!partial.renameTo(target)) return download.file + ": unable to save";
+            if (download.extractCab && !extractEmbeddedCab(target, cabFile(target))) {
+                return context.getString(R.string.deps_no_cabinet, download.file);
+            }
+            FileUtils.writeString(new File(target.getPath() + ".sha256"), download.sha256);
+            return null;
+        }
+        catch (Exception e) {
+            return download.file + ": " + (e.getMessage() != null ? e.getMessage() : e.getClass().getSimpleName());
+        }
+        finally {
+            if (connection != null) connection.disconnect();
+            if (partial.exists() && cancelled.get()) partial.delete();
+        }
+    }
+
+    private static String hex(byte[] bytes) {
+        StringBuilder sb = new StringBuilder();
+        for (byte b : bytes) sb.append(String.format(Locale.ENGLISH, "%02x", b));
+        return sb.toString();
+    }
+
+    /**
+     * Copies the first valid Microsoft Cabinet embedded in a self-extracting EXE into its own
+     * file, so Wine's extrac32 can unpack it. The cabinet data itself (MSZIP/LZX) is not decoded here.
+     */
+    static boolean extractEmbeddedCab(File exe, File out) {
+        try (RandomAccessFile file = new RandomAccessFile(exe, "r")) {
+            long length = file.length();
+            byte[] window = new byte[1 << 20];
+            ByteBuffer header = ByteBuffer.allocate(36).order(ByteOrder.LITTLE_ENDIAN);
+            for (long base = 0; base < length; base += window.length - 36) {
+                file.seek(base);
+                int read = file.read(window);
+                if (read <= 0) break;
+                for (int i = 0; i + 36 <= read; i++) {
+                    if (window[i] != 'M' || window[i + 1] != 'S' || window[i + 2] != 'C' || window[i + 3] != 'F') continue;
+                    header.clear();
+                    header.put(window, i, 36).flip();
+                    int reserved1 = header.getInt(4);
+                    long size = header.getInt(8) & 0xffffffffL;
+                    int reserved2 = header.getInt(12);
+                    int minor = header.get(24), major = header.get(25);
+                    long offset = base + i;
+                    if (reserved1 != 0 || reserved2 != 0 || major != 1 || minor != 3 || size < 36 || offset + size > length) continue;
+                    file.seek(offset);
+                    try (OutputStream output = new FileOutputStream(out)) {
+                        byte[] buffer = new byte[65536];
+                        long remaining = size;
+                        while (remaining > 0) {
+                            int n = file.read(buffer, 0, (int)Math.min(buffer.length, remaining));
+                            if (n <= 0) return false;
+                            output.write(buffer, 0, n);
+                            remaining -= n;
+                        }
+                    }
+                    return true;
+                }
+                if (read < window.length) break;
+            }
+        }
+        catch (IOException ignored) {}
+        return false;
+    }
+
+    // ---------------------------------------------------------------- install script
+
+    /**
+     * Writes C:\miniexe\install.bat for the given installer items (already ordered and cached)
+     * and returns its Unix path. Results go to C:\miniexe\install-log.txt and per-item status
+     * files; the log opens in Notepad when the script finishes.
+     */
+    public static File writeInstallScript(Context context, Container container, Catalog catalog, List<Item> items, boolean monoInstalled) throws IOException {
+        File driveC = new File(container.getRootDir(), ".wine/drive_c");
+        File installDir = new File(driveC, INSTALL_DIR);
+        File statusDir = new File(installDir, "status");
+        if (!statusDir.isDirectory()) statusDir.mkdirs();
+        File link = new File(installDir, "cache");
+        File cache = cacheDir(context);
+        if (!cache.isDirectory()) cache.mkdirs();
+        if (!FileUtils.isSymlink(link) || !cache.getPath().equals(FileUtils.readSymlink(link))) {
+            FileUtils.delete(link);
+            FileUtils.symlink(cache, link);
+        }
+
+        final String log = "C:\\miniexe\\install-log.txt";
+        StringBuilder bat = new StringBuilder();
+        bat.append("@echo off\r\n");
+        bat.append("echo MiniEXE dependency install > ").append(log).append("\r\n");
+        boolean monoPresent = monoInstalled;
+        Item mono = catalog.get("mono");
+        for (Item item : items) {
+            new File(statusDir, item.id + ".txt").delete();
+            String cacheDir = "C:\\miniexe\\cache\\" + item.id;
+            String tmpDir = "C:\\miniexe\\tmp\\" + item.id;
+            bat.append("\r\nrem ---- ").append(item.id).append("\r\n");
+            bat.append("echo [").append(item.id).append("] ").append(ascii(item.name)).append(" >> ").append(log).append("\r\n");
+            bat.append("set MINIEXE_RC=0\r\n");
+            bat.append("if not exist ").append(tmpDir).append(" mkdir ").append(tmpDir).append("\r\n");
+            if (item.removeMono && monoPresent && mono != null && !mono.downloads.isEmpty()) {
+                bat.append("echo   removing Wine Mono >> ").append(log).append("\r\n");
+                bat.append("start /wait msiexec.exe /x C:\\miniexe\\cache\\mono\\").append(mono.downloads.get(0).file).append(" /qn\r\n");
+                monoPresent = false;
+            }
+            if ("mono".equals(item.id)) monoPresent = true;
+            if (!item.winver.isEmpty()) bat.append("reg add \"HKCU\\Software\\Wine\" /v Version /t REG_SZ /d ").append(item.winver).append(" /f >nul\r\n");
+            for (Map.Entry<String, List<String>> entry : item.overrides.entrySet()) {
+                for (String dll : entry.getValue()) {
+                    bat.append("reg add \"HKCU\\Software\\Wine\\DllOverrides\" /v ").append(dll)
+                       .append(" /t REG_SZ /d ").append(entry.getKey()).append(" /f >nul\r\n");
+                }
+            }
+            if (!item.env.isEmpty()) bat.append("set ").append(item.env).append("\r\n");
+            for (String command : item.commands) {
+                String line = command.replace("{cache}", cacheDir).replace("{tmp}", tmpDir);
+                bat.append(line).append("\r\n");
+                bat.append("if errorlevel 1 set MINIEXE_RC=%errorlevel%\r\n");
+            }
+            if (!item.env.isEmpty()) bat.append("set ").append(item.env, 0, item.env.indexOf('=') + 1).append("\r\n");
+            if (!item.winver.isEmpty()) bat.append("reg delete \"HKCU\\Software\\Wine\" /v Version /f >nul 2>nul\r\n");
+            bat.append("echo   exit code %MINIEXE_RC% >> ").append(log).append("\r\n");
+            bat.append("echo %MINIEXE_RC% > C:\\miniexe\\status\\").append(item.id).append(".txt\r\n");
+            bat.append("rmdir /s /q ").append(tmpDir).append(" >nul 2>nul\r\n");
+        }
+        bat.append("\r\necho. >> ").append(log).append("\r\n");
+        bat.append("echo Finished. Return to MiniEXE and open Dependencies to see verified status. >> ").append(log).append("\r\n");
+        bat.append("start notepad.exe ").append(log).append("\r\n");
+
+        File script = new File(installDir, "install.bat");
+        FileUtils.write(script, bat.toString().getBytes(StandardCharsets.US_ASCII));
+        return script;
+    }
+
+    private static String ascii(String text) {
+        return text.replaceAll("[^ -~]", "-").replaceAll("[<>|&^%]", " ");
+    }
+
+    /** Runs the script in the container's running session, or starts a session for it. */
+    public static void launch(Activity activity, Container container, File script) {
+        if (XServerDisplayActivity.tryLaunchInSession(activity, container.id, script.getPath(), false)) return;
+        Intent intent = new Intent(activity, XServerDisplayActivity.class);
+        intent.putExtra("container_id", container.id);
+        intent.putExtra("exec_path", script.getPath());
+        activity.startActivity(intent);
+    }
+}
